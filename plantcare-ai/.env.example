# ===== Base de service =====
DATABASE_URL=postgresql+psycopg2://plantcare:plantcare@localhost:5432/plantcare

# ===== Datalake (local | minio | gcs) =====
DATALAKE_BACKEND=local
DATALAKE_ROOT=./datalake
# Si DATALAKE_BACKEND=minio :
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ===== Option A — Vertex AI Gemini (FACULTATIF) =====
# Laisse vide pour utiliser le gabarit local de secours.
# GCP_PROJECT=mon-projet-gcp
# GCP_LOCATION=europe-west1
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/gcp-key.json

# ===== Option A bis — OpenWeatherMap (FACULTATIF) =====
# Permet d'ajouter la météo locale dans le prompt LLM.
# OPENWEATHER_API_KEY=votre_cle_ici
# OPENWEATHER_DEFAULT_CITY=Paris
# OPENWEATHER_DEFAULT_COUNTRY=FR
# OPENWEATHER_DEFAULT_LAT=48.8566
# OPENWEATHER_DEFAULT_LON=2.3522
# OPENWEATHER_DEFAULT_UNITS=metric
# OPENWEATHER_DEFAULT_LANG=fr

# ===== Option D — plant.health / Kindwise (FACULTATIF) =====
# PLANT_HEALTH_API_KEY=votre_cle_ici

# ===== MLflow =====
MLFLOW_TRACKING_URI=http://localhost:5000

# ===== Dashboard =====
API_URL=http://localhost:8000
